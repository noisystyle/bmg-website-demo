Options -Indexes -MultiViews
DirectoryIndex index.html index.php

# Keep the deployment marker inaccessible from the web.
<Files ".git-ftp.log">
    Require all denied
</Files>

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://bemarketinggroup.it%{REQUEST_URI} [R=301,L]

# Redirect only explicit browser requests, never internal rewrites.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Serve existing HTML pages at extensionless URLs.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
    <Files "beviral.html">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>
